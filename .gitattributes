# 仓库内统一按文本处理，提交时保持一致
* text=auto

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Pinned resource hashes must be identical on Windows and macOS checkouts.
src-tauri/resources/conpty/*.txt -text whitespace=cr-at-eol
src-tauri/resources/conpty/*.md text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.woff binary
*.woff2 binary
