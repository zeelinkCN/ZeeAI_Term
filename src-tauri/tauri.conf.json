{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZeeAI_Term",
  "mainBinaryName": "ZeeAI_Term",
  "version": "0.1.14",
  "identifier": "com.zeeai.terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ZeeAI Term",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws: http://localhost:* https: http:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/platform-tools/*"],
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
