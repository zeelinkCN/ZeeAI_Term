{
  "name": "zeeai-terminal",
  "private": true,
  "version": "0.1.15",
  "type": "module",
  "description": "Windows and macOS multi-protocol terminal workbench",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "fe:smoke": "node scripts/fe-smoke.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:platform": "node --experimental-strip-types --test scripts/platform.test.mjs scripts/updates.test.mjs",
    "test:ai": "node --experimental-strip-types --test scripts/program-status.test.mjs scripts/ai-monitor.test.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
